# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIND NICHE CONFIGURATION
# Admin master passcode for the private dashboard
ADMIN_PASSCODE="findniche2026"

# Admin bearer authentication token
ADMIN_TOKEN="findniche_admin_secure_token_2026"

# Port configuration
PORT=3000
