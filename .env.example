# ==============================================================================
# FIND NICHE — ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Required for owner administration access. Must be a strong, private passcode.
ADMIN_PASSCODE="your_strong_admin_passcode_here"

# Optional: External PostgreSQL / Supabase database connection string.
# If omitted, Find Niche runs on its built-in relational SQLite persistence engine (data/findniche.sqlite).
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# Port configuration (Defaults to 3000)
PORT=3000

# Node Environment: "development" or "production"
NODE_ENV="production"
